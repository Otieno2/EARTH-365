# EARTH-365 API — local development environment variables.
# Copy this file to `.env` and fill in any values you need to override.

# Server
PORT=3000
NODE_ENV=development

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://earth365:earth365_dev_password@localhost:5432/earth365?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (replace in production)
JWT_SECRET=dev-secret-change-me-in-prod
JWT_EXPIRES_IN=7d

# Game-economy tuning (can be tweaked without code changes)
ECONOMY_NEW_PLAYER_EARTHCOIN=500
ECONOMY_PROPERTY_TAX_RATE_WEEKLY=0.005
ECONOMY_MARKETPLACE_FEE_BPS=700
ECONOMY_CITY_TAX_BPS=500
ECONOMY_CORP_CONTROL_BPS=200
